{
  "name": "@sbaiahmed1/react-native-blur",
  "version": "6.0.1",
  "description": "React native modern blur view",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "browser": "./lib/module/index.web.js",
      "react-native": "./lib/module/index.js",
      "default": "./lib/module/index.web.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "keywords": [
    "react-native",
    "ios",
    "android",
    "blur",
    "react blur",
    "react native blur",
    "modern blur"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sbaiahmed1/react-native-blur.git"
  },
  "author": "Ahmed Sbai <ahmedclubust@gmail.com> (https://github.com/sbaiahmed1)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sbaiahmed1/react-native-blur/issues"
  },
  "homepage": "https://github.com/sbaiahmed1/react-native-blur#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.80.0"
  },
  "packageManager": "npm@12.0.2",
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "codegenConfig": {
    "name": "ReactNativeBlurViewSpec",
    "type": "all",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.sbaiahmed1.reactnativeblur"
    },
    "ios": {
      "componentProvider": {
        "ReactNativeBlurView": "ReactNativeBlurView",
        "ReactNativeLiquidGlassView": "ReactNativeLiquidGlassView",
        "ReactNativeProgressiveBlurView": "ReactNativeProgressiveBlurView",
        "ReactNativeLiquidGlassContainer": "ReactNativeLiquidGlassContainer",
        "ReactNativeVibrancyView": "ReactNativeVibrancyView"
      }
    }
  }
}
